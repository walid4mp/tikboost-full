# ===== Server =====
NODE_ENV=production
PORT=4000
APP_NAME=TikBoost
APP_URL=https://tikboost-api-v2.onrender.com

# ===== Database =====
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tikboost

# ===== Auth =====
JWT_ACCESS_SECRET=replace_me_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_me_with_a_long_random_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
BCRYPT_ROUNDS=10

# ===== Admin =====
SEED_ADMIN_EMAIL=admin@tikboost.app
SEED_ADMIN_PASSWORD=ChangeMeBeforeProduction_2026!
SEED_ADMIN_NAME=Super Admin

# ===== Anti-abuse =====
TASK_COOLDOWN_SECONDS=8
MAX_CAMPAIGNS_PER_USER=20
FREEZE_DURATION_MIN=60

# ===== Socket.io / CORS =====
SOCKET_CORS_ORIGIN=*

# ===== Features =====
ENABLE_GOOGLE_LOGIN=true

# ===== Mail (Gmail SMTP) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tikboost.wh@gmail.com
# Set in Render dashboard only — never commit:
# SMTP_PASSWORD=<gmail-app-password>
MAIL_FROM=tikboost.wh@gmail.com
PASSWORD_RESET_TTL_MIN=15
