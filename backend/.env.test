NODE_ENV=test
PORT=4001
APP_NAME=TikBoost
APP_URL=http://127.0.0.1:4001
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/tikboost_test?schema=public
JWT_ACCESS_SECRET=test_access_secret_please_change
JWT_REFRESH_SECRET=test_refresh_secret_please_change
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
BCRYPT_ROUNDS=4
SEED_ADMIN_EMAIL=admin@tikboost.app
SEED_ADMIN_PASSWORD=Admin@123456
SEED_ADMIN_NAME=Super Admin
TASK_COOLDOWN_SECONDS=0
MAX_CAMPAIGNS_PER_USER=50
FREEZE_DURATION_MIN=60
SOCKET_CORS_ORIGIN=*
ENABLE_GOOGLE_LOGIN=false
ENABLE_LEGACY_PASSWORD_RESET=false
